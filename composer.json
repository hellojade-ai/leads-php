{
    "name": "hellojade/intake",
    "description": "PHP client for the hellojade Partner Intake API: submit leads to https://intake.hellojade.ai with idempotency, Retry-After-aware retries, and typed errors. cURL only, no runtime dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": ["hellojade", "intake", "leads", "api-client"],
    "homepage": "https://intake.hellojade.ai/api",
    "authors": [
        {
            "name": "hellojade",
            "email": "developers@hellojade.ai"
        }
    ],
    "support": {
        "docs": "https://intake.hellojade.ai/api",
        "issues": "https://github.com/hellojade-ai/leads-php/issues",
        "source": "https://github.com/hellojade-ai/leads-php",
        "security": "https://github.com/hellojade-ai/leads-php/blob/main/SECURITY.md"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11 || ^12"
    },
    "suggest": {
        "psr/http-client": "To route requests through any PSR-18 HTTP client via HelloJade\\Intake\\Transport\\Psr18Transport",
        "psr/http-factory": "Required alongside psr/http-client for Psr18Transport"
    },
    "autoload": {
        "psr-4": {
            "HelloJade\\Intake\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HelloJade\\Intake\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
